# WAJIB: PostgreSQL terkelola yang dapat dijangkau deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Sangat disarankan. Jika kosong, Agent Runner production menolak berjalan.
APP_BASE_URL=https://harness.example.com

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Pilot gate
PILOT_USERNAME=harness
PILOT_ACCESS_KEY=ganti-dengan-rahasia-panjang-dan-acak

# Rate limit
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_GENERATE=10
RATE_LIMIT_MUTATION=60
RATE_LIMIT_PREVIEW=20

# Jika deployment berada di belakang proxy terpercaya (Vercel/Railway/Render), biarkan 1.
# Jika ingin rate limit tidak memakai header IP, set 0.
TRUST_PROXY=1

# Pool PostgreSQL
PG_POOL_MAX=10

# Hanya untuk development lokal. Jangan aktifkan di production.
ALLOW_LOCAL_SSRF=0

# Opsional: shared rate limit production (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
